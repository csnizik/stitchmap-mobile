# Example environment variables for StitchMap Mobile.
#
# Copy this file to `.env` and fill in real values for local development:
#
#   cp .env.example .env
#
# Variables prefixed with EXPO_PUBLIC_ are embedded in the client bundle at
# build time, so they must NOT contain secrets. See:
# https://docs.expo.dev/guides/environment-variables/EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDpPYjqOY-5iDPmDHa4YAttlrmAnvX7S0c
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

SENTRY_AUTH_TOKEN=

# Sentry Data Source Name (DSN) for error tracking.
# Leave empty to disable Sentry — the app boots normally without it.
# Obtain this from your Sentry project: Settings -> Projects -> Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
