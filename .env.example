# Firebase web config — copy to `.env` and fill in your project's values.
#
# These are read by lib/firebase/config.ts. The `EXPO_PUBLIC_` prefix makes
# Expo inline them into the client bundle at build time. A Firebase web config
# is not secret (access is enforced by Auth + Security Rules), but it is kept
# out of source so each environment can supply its own project.
#
# Get these from the Firebase console: Project settings → Your apps → Web app.
# `.env` is gitignored; never commit real values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
